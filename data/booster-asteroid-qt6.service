[Unit]
Description=Application launch booster for QML Asteroid
Requires=dbus.socket asteroid-launcher.service
After=asteroid-launcher.service
ConditionUser=!root

[Service]
Type=notify
ExecStart=/usr/libexec/mapplauncherd/booster-asteroid-qt6 --systemd
EnvironmentFile=/var/lib/environment/mapplauncherd/asteroid-qt6.conf
OOMScoreAdjust=-250

[Install]
WantedBy=user-session.target
